+float VulkanContext::UpdateWindowExposure(float seconds) {
+    std::lock_guard<std::recursive_mutex> lock(mGraphicsMutex);
+    // A metering frame's step, once its frame is surely done (its arena's come round again).
+    if(mWindowMeterOutput && ++mWindowMeterAge>FrameArenaCount) {
+        for(const auto& t:mHdrTargets) {
+            if(t.output!=mWindowMeterOutput || !(t.layers==2 || t.layer==0) || !t.meterMapped) continue;
+            // hdr_exposure.comp: exposure = mix(previous, target, 0.075 down or 0.035 up), and no
+            // step when it found nothing but sky.
+            const float stepped=static_cast<const float*>(t.meterMapped)[0];
+            if(stepped!=mWindowMeterSeed) {
+                const float rate=stepped<mWindowMeterSeed?0.075f:0.035f;
+                const float target=std::fmin(std::fmax(mWindowMeterSeed+(stepped-mWindowMeterSeed)/rate,0.60f),1.80f);
+                if(mWindowExposureTarget<=0.0f) mWindowExposure=target;
+                mWindowExposureTarget=target;
+            }
+            break;
+        }
+        mWindowMeterOutput=VK_NULL_HANDLE;
+    }
+    // The meter takes those steps once a swapchain image comes round, every third frame at 90 Hz:
+    // down with a time constant of 0.43 s, up with 0.94 s.
+    if(mWindowExposureTarget>0.0f) {
+        const float constant=mWindowExposureTarget<mWindowExposure?0.43f:0.94f;
+        mWindowExposure+=(mWindowExposureTarget-mWindowExposure)*(1.0f-std::exp(-seconds/constant));
+    }
+    return mWindowExposure;
+}
+void VulkanContext::SetWindowSceneCapture(VkImage output,VkImage capture) {
+    mWindowCaptureOutput=capture?output:VK_NULL_HANDLE;
+    mWindowCaptureImage=output?capture:VK_NULL_HANDLE;
+    mWindowCapturedEyes=mWindowDepthEyes=0;
+}
+bool VulkanContext::TakeWindowSceneCapture(VkImage* depth,float projection[2][16]) {
+    const bool captured=mWindowCapturedEyes==3u && mWindowDepthEyes==3u;
+    mWindowCapturedEyes=mWindowDepthEyes=0;
+    if(!captured) return false;
+    *depth=mWindowDepth;
+    std::memcpy(projection,mWindowCaptureProjection,sizeof(mWindowCaptureProjection));
+    return true;
+}
+VkImage VulkanContext::FindHdrDepth(const HdrTarget& t) {
+    for(auto& d:mDepthTargetCache) if(d.colourImage==t.colour && d.arrayLayer==t.layer) return d.image;
+    return VK_NULL_HANDLE;
