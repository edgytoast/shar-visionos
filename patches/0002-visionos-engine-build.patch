+if(SRR2_ENABLE_OPENXR AND (WIN32 OR SRR2_VISIONOS) AND NOT ANDROID)
 	set(SRR2_REGION "PAL" CACHE STRING "Select PAL for the EFIGS multi-language version" FORCE)
 endif()
 
@@ -118,10 +132,22 @@ if(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android")
 endif()
 
 if(SRR2_ENABLE_OPENXR AND NOT ANDROID AND SRR2_VR_RENDERER STREQUAL "VULKAN")
+	# visionOS: pass -DVulkan_INCLUDE_DIR/-DVulkan_LIBRARY pointing at MoltenVK.
 	find_package(Vulkan REQUIRED)
 	set(VULKAN_LIBRARY Vulkan::Vulkan)
 endif()
 
+if(SRR2_VISIONOS)
+	add_definitions(-DRAD_VISIONOS)
+	# The SwiftUI shell owns the process entry point. SDL_main.h still renames the game's main()
+	# to SDL_main(), but must not supply its own main(), which would collide with the app's.
+	add_definitions(-DSDL_MAIN_NOIMPL)
+	# MoltenVK's Vulkan headers must win over the older copy in SDL3's Khronos dir, which is
+	# only here for the OpenXR headers (same source Android uses).
+	include_directories(${Vulkan_INCLUDE_DIRS})
+	include_directories("${CMAKE_CURRENT_SOURCE_DIR}/libs/SDL3/src/video/khronos")
+endif()
+
 find_program(CCACHE_FOUND ccache)
 if(CCACHE_FOUND)
     set_property(GLOBAL PROPERTY RULE_LAUNCH_COMPILE ccache)
@@ -129,7 +155,17 @@ endif()
 
 
