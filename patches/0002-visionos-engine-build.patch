+    barriers[0].dstAccessMask=VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT|VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    barriers[0].oldLayout=VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[0].newLayout=VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    vkCmdPipelineBarrier(mCommandBuffer,VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT|VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+        0,0,nullptr,0,nullptr,1,barriers);
+    mWindowDepthEyes|=eyes;
+}
+void VulkanContext::SnapshotWindowDepthBeforeClear() {
+    if(!mWindowCaptureOutput) return;
+    for(auto& t:mHdrTargets) {
+        if(!t.active || t.output!=mWindowCaptureOutput || t.failed) continue;
+        if(const VkImage depth=FindHdrDepth(t)) SnapshotWindowDepth(t,depth);
