+++ b/code/CMakeLists.txt
@@ -627,9 +627,29 @@ if(SRR2_REGION STREQUAL "PAL")
 	)
 endif()
 
+if(SRR2_VISIONOS)
+	# No OpenXR loader on visionOS; these two files are the only OpenXR API callers outside the
+	# runtime. The runtime itself stays: on visionOS its OpenXR internals are replaced by the
+	# CompositorServices core in vr/visionos/ (linked in from the SHAR VR repository by its bootstrap.sh).
+	list(REMOVE_ITEM SRR2_SOURCES
+		"vr/openxr_platform_loader.cpp"
+		"vr/openxr_platform_instance.cpp")
+	# Called on every platform; only the Android and Win32 lists above added it.
+	list(APPEND SRR2_SOURCES "vr/visionos/visionos_compositor.mm" "vr/visionos/visionos_controllers.mm"
+		"vr/visionos/visionos_present.mm" "vr/visionos/visionos_window.mm" "vr/visionos/visionos_mirror.mm"
+		"input/touch/touchinputmodemanager.cpp")
+	set_source_files_properties("vr/visionos/visionos_compositor.mm" "vr/visionos/visionos_controllers.mm"
+		"vr/visionos/visionos_present.mm" "vr/visionos/visionos_window.mm" "vr/visionos/visionos_mirror.mm"
+		PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
+endif()
+
 if(ANDROID)
     add_library(main SHARED ${SRR2_SOURCES})
     set(SRR2_TARGET main)
+elseif(SRR2_VISIONOS)
+    # Linked into the SwiftUI app shell, which owns the process entry point.
+    add_library(main STATIC ${SRR2_SOURCES})
+    set(SRR2_TARGET main)
 else()
     add_executable(${PROJECT_NAME} ${SRR2_SOURCES})
     set(SRR2_TARGET ${PROJECT_NAME})
