-if(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android")
+if(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android" OR SRR2_VISIONOS)
 	set(SRR2_OPENXR_DEFAULT ON)
 else()
 	set(SRR2_OPENXR_DEFAULT OFF)
@@ -39,6 +47,12 @@ if(SRR2_ENABLE_OPENXR)
 		add_definitions(-DSRR2_OPENXR_PLATFORM_ANDROID=1)
 	elseif(WIN32)
 		add_definitions(-DSRR2_OPENXR_PLATFORM_WIN32=1)
+	elseif(SRR2_VISIONOS)
+		# visionOS takes the desktop-VR (PCVR) code paths. Upstream gates those on
+		# SRR2_OPENXR_PLATFORM_WIN32 in ~330 places, almost all of them VR-behaviour switches
+		# rather than Windows APIs. The few truly Windows-specific sites exclude
+		# SRR2_OPENXR_PLATFORM_VISIONOS explicitly.
+		add_definitions(-DSRR2_OPENXR_PLATFORM_VISIONOS=1 -DSRR2_OPENXR_PLATFORM_WIN32=1)
 	endif()
 	message(STATUS "OpenXR support: enabled")
 else()
@@ -48,7 +62,7 @@ endif()
