 void radMemoryFreeAligned( void * pMemory )
 {
+#if defined( RAD_VISIONOS )
+    // Nothing comes from a game allocator before radMemoryInitialize(), so this is malloc memory,
+    // and the allocator tree is still empty (its root has no allocator to ask).
+    if ( !g_Initialized )
+    {
+        radMemoryPlatFreeAligned( pMemory );
+        return;
+    }
+#endif
     LEAK_DETECTION_REMOVE_ALLOCATION( pMemory );
     rAssert( g_Initialized == true );
 
@@ -720,6 +729,15 @@ void radMemoryFreeAligned( void * pMemory )
 
 void radMemoryFree( void * pMemory )
 {
+#if defined( RAD_VISIONOS )
+    // Nothing comes from a game allocator before radMemoryInitialize(), so this is malloc memory,
+    // and the allocator tree is still empty (its root has no allocator to ask).
+    if ( !g_Initialized )
+    {
+        radMemoryPlatFree( pMemory );
+        return;
+    }
+#endif
     LEAK_DETECTION_REMOVE_ALLOCATION( pMemory );
