+// Straight after the resolve wrote the tone-mapped scene into the eye image, and before the HUD
+// goes over it: that eye's layer, or both for a multiview scene, into the capture image, which the
+// window reads once the frame is done.
+void VulkanContext::CaptureWindowScene(HdrTarget& t,VkImage depth) {
+    const uint32_t firstLayer=t.layers==2?0u:t.layer, layerCount=t.layers==2?2u:1u;
+    SnapshotWindowDepth(t,depth);
+    VkImageMemoryBarrier barriers[2]={};
+    for(auto& b:barriers) { b.sType=VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        b.srcQueueFamilyIndex=b.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;
+        b.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,firstLayer,layerCount}; }
+    barriers[0].image=t.output;
+    barriers[0].srcAccessMask=VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barriers[0].dstAccessMask=VK_ACCESS_TRANSFER_READ_BIT;
+    barriers[0].oldLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    barriers[0].newLayout=VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[1].image=mWindowCaptureImage;
+    barriers[1].dstAccessMask=VK_ACCESS_TRANSFER_WRITE_BIT;
+    barriers[1].oldLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+    barriers[1].newLayout=VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    vkCmdPipelineBarrier(mCommandBuffer,VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT|
+        VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,2,barriers);
+    VkImageCopy region={};
+    region.srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,firstLayer,layerCount};
+    region.dstSubresource=region.srcSubresource;
+    region.extent={t.width,t.height,1};
+    vkCmdCopyImage(mCommandBuffer,t.output,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,mWindowCaptureImage,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,1,&region);
+    barriers[0].srcAccessMask=VK_ACCESS_TRANSFER_READ_BIT;
+    barriers[0].dstAccessMask=VK_ACCESS_COLOR_ATTACHMENT_READ_BIT|VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barriers[0].oldLayout=VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[0].newLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    vkCmdPipelineBarrier(mCommandBuffer,VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,0,0,nullptr,0,nullptr,1,barriers);
+    for(uint32_t i=0;i<layerCount;++i) {
+        const uint32_t eye=firstLayer+i;
+        std::memcpy(mWindowCaptureProjection[eye],t.projection[t.layers==2?eye:0u],sizeof(float)*16);
+        mWindowCapturedEyes|=1u<<eye;
+    }
+}
