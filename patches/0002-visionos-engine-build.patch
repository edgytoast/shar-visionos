+    set(ALSOFT_UTILS OFF CACHE BOOL "" FORCE)
+    set(ALSOFT_EXAMPLES OFF CACHE BOOL "" FORCE)
+    set(ALSOFT_INSTALL OFF CACHE BOOL "" FORCE)
+    add_subdirectory(libs/openal-soft EXCLUDE_FROM_ALL)
+    find_package(ZLIB REQUIRED)
+    # The non-Android library paths link PNG::PNG and read OPENAL_INCLUDE_DIR.
+    add_library(PNG::PNG INTERFACE IMPORTED)
+    target_link_libraries(PNG::PNG INTERFACE png_static ZLIB::ZLIB)
+    target_include_directories(PNG::PNG INTERFACE "${CMAKE_SOURCE_DIR}/libs/libpng")
+    set(OPENAL_INCLUDE_DIR "${CMAKE_SOURCE_DIR}/libs/openal-soft/include/AL")
 else()
     find_package(PNG REQUIRED)
 endif()
@@ -183,7 +233,7 @@ endif()
 set(THREADS_PREFER_PTHREAD_FLAG ON)
 find_package(Threads REQUIRED)
 
-if(NOT ANDROID)
