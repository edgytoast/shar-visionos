+# visionOS, so the shared VR layer compiles against the OpenXR headers for its types only.
+if(CMAKE_SYSTEM_NAME STREQUAL "visionOS")
+	set(SRR2_VISIONOS ON)
+	# The CompositorServices/ARKit backend is Objective-C++; this must be enabled at top level.
+	enable_language(OBJCXX)
+endif()
+
 set(SRR2_TITLE "Simpsons Hit & Run")
 set(SRR2_VERSION "00.61")
 set(SRR2_FILENAME "Simpsons")
