+// Copies the world's depth for the target's eyes (its layer, or both) into the window's own
+// 2-layer depth image, once per eye per frame.
+void VulkanContext::SnapshotWindowDepth(HdrTarget& t,VkImage depth) {
+    const uint32_t firstLayer=t.layers==2?0u:t.layer, layerCount=t.layers==2?2u:1u;
+    const uint32_t eyes=(t.layers==2?3u:1u<<t.layer)&~mWindowDepthEyes;
+    if(!eyes || firstLayer>1) return;
+    if(mWindowDepth && (mWindowDepthWidth!=t.width || mWindowDepthHeight!=t.height)) {
+        // Render Scale changed: retire the old image once this frame is done with it.
+        mDeferredImages.push_back(mWindowDepth);
+        mDeferredImageMemory.push_back(mWindowDepthMemory);
+        mWindowDepth=VK_NULL_HANDLE; mWindowDepthMemory=VK_NULL_HANDLE;
+    }
+    if(!mWindowDepth) {
+        VkImageCreateInfo di={VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        di.imageType=VK_IMAGE_TYPE_2D; di.format=VK_FORMAT_D24_UNORM_S8_UINT;
+        di.extent={t.width,t.height,1}; di.mipLevels=1; di.arrayLayers=2;
+        di.samples=VK_SAMPLE_COUNT_1_BIT; di.tiling=VK_IMAGE_TILING_OPTIMAL;
+        di.usage=VK_IMAGE_USAGE_SAMPLED_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+        di.sharingMode=VK_SHARING_MODE_EXCLUSIVE; di.initialLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+        VkMemoryRequirements requirements={};
+        uint32_t type=0;
+        VkMemoryAllocateInfo allocation={VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        if(vkCreateImage(mDevice,&di,nullptr,&mWindowDepth)!=VK_SUCCESS) { mWindowDepth=VK_NULL_HANDLE; return; }
+        vkGetImageMemoryRequirements(mDevice,mWindowDepth,&requirements);
+        allocation.allocationSize=requirements.size;
+        if(!FindMemoryType(requirements.memoryTypeBits,VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,&type) ||
+           (allocation.memoryTypeIndex=type,vkAllocateMemory(mDevice,&allocation,nullptr,&mWindowDepthMemory))!=VK_SUCCESS ||
+           vkBindImageMemory(mDevice,mWindowDepth,mWindowDepthMemory,0)!=VK_SUCCESS) {
+            if(mWindowDepthMemory) vkFreeMemory(mDevice,mWindowDepthMemory,nullptr);
+            vkDestroyImage(mDevice,mWindowDepth,nullptr);
+            mWindowDepth=VK_NULL_HANDLE; mWindowDepthMemory=VK_NULL_HANDLE;
+            return;
+        }
+        mWindowDepthWidth=t.width; mWindowDepthHeight=t.height;
+    }
+    EndActiveRenderPass();
+    VkImageMemoryBarrier barriers[2]={};
+    for(auto& b:barriers) { b.sType=VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+        b.srcQueueFamilyIndex=b.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED; }
+    barriers[0].image=depth;
+    barriers[0].subresourceRange={VK_IMAGE_ASPECT_DEPTH_BIT|VK_IMAGE_ASPECT_STENCIL_BIT,0,1,0,layerCount};
+    barriers[0].srcAccessMask=VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    barriers[0].dstAccessMask=VK_ACCESS_TRANSFER_READ_BIT;
+    barriers[0].oldLayout=VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    barriers[0].newLayout=VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[1].image=mWindowDepth;
+    barriers[1].subresourceRange={VK_IMAGE_ASPECT_DEPTH_BIT|VK_IMAGE_ASPECT_STENCIL_BIT,0,1,firstLayer,layerCount};
+    barriers[1].dstAccessMask=VK_ACCESS_TRANSFER_WRITE_BIT;
+    barriers[1].oldLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+    barriers[1].newLayout=VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    vkCmdPipelineBarrier(mCommandBuffer,VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT|
+        VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT|VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,2,barriers);
+    VkImageCopy region={};
+    region.srcSubresource={VK_IMAGE_ASPECT_DEPTH_BIT,0,0,layerCount};
+    region.dstSubresource={VK_IMAGE_ASPECT_DEPTH_BIT,0,firstLayer,layerCount};
+    region.extent={t.width,t.height,1};
