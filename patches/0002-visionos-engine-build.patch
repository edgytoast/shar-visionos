+    # The vendored SDL2 has no visionOS support; the vendored SDL3 does, and the engine already
+    # has SDL3 code paths (the desktop build prefers SDL3 as well).
+    message(STATUS "visionOS build - compiling vendored SDL3")
+    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+    set(SDL_STATIC ON CACHE BOOL "" FORCE)
+    set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
+    add_subdirectory(libs/SDL3 SDL3_Build EXCLUDE_FROM_ALL)
+    include_directories("${CMAKE_CURRENT_SOURCE_DIR}/libs/SDL3/include/SDL3")
+    set(SDL_LIBRARY SDL3::SDL3-static)
+elseif(ANDROID OR CMAKE_SYSTEM_NAME STREQUAL "Android" OR SRR2_ENABLE_OPENXR)
     # Quest and PCVR use the same vendored SDL2 revision.
