    # Pure3D's blend modes, through premultiplied-alpha blending (dst * (1 - opacity) + colour):
    #   colour  = mix(exposed, tone-mapped, Curve) * (ColourBase + ColourAlpha * a)
    #   opacity = OpacityBase + OpacityAlpha * a + OpacityLuma * luma(linear)
    # Alpha is (0, 1 | 0, 1, 0 | 1); add (1, 0 | 0, 0, 0 | 0); modulate, which darkens dst by src, is
    # black at 1 - luma (0, 0 | 1, 0, -1 | 0). The engine blends before its tone curve; over a picture
    # already through it, a glow added uncurved is nearer than one through the curve's dark toe.
    # MirrorScene.swift sets them per mode.
    def Material "MirrorBlend"
    {
        asset inputs:Frame
        asset inputs:Constants
        float4 inputs:Colour = (1, 1, 1, 1)
        float inputs:ColourBase = 0
        float inputs:ColourAlpha = 1
        float inputs:OpacityBase = 0
        float inputs:OpacityAlpha = 1
        float inputs:OpacityLuma = 0
        float inputs:Curve = 1
        token outputs:mtlx:surface.connect = </Root/MirrorBlend/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            bool inputs:hasPremultipliedAlpha = 1
            color3f inputs:color.connect = </Root/MirrorBlend/RGB.outputs:out>
            float inputs:opacity.connect = </Root/MirrorBlend/Opacity.outputs:out>
            token outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorBlend.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/MirrorBlend/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            string inputs:u_wrap_mode = "repeat"
            string inputs:v_wrap_mode = "repeat"
            float4 outputs:out
        }

        def Shader "UV"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "VertexColour"
        {
            uniform token info:id = "ND_geomcolor_color4"
            color4f outputs:out
        }

        def Shader "VertexVector"
        {
            uniform token info:id = "ND_convert_color4_vector4"
            color4f inputs:in.connect = </Root/MirrorBlend/VertexColour.outputs:out>
            float4 outputs:out
        }

        def Shader "Tint"
        {
            uniform token info:id = "ND_multiply_vector4"
            float4 inputs:in1.connect = </Root/MirrorBlend/VertexVector.outputs:out>
            float4 inputs:in2.connect = </Root/MirrorBlend.inputs:Colour>
            float4 outputs:out
        }

        def Shader "TintSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorBlend/Tint.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "TintRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorBlend/TintSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlend/TintSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorBlend/TintSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "Constant0"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorBlend.inputs:Constants>
            float2 inputs:texcoord = (0.0625, 0.5)
            float4 outputs:out
        }

        def Shader "Constant0Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorBlend/Constant0.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "ClampedTint"
        {
            uniform token info:id = "ND_clamp_vector3FA"
            float3 inputs:in.connect = </Root/MirrorBlend/TintRGB.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float3 outputs:out
        }

        def Shader "LinearTint"
        {
            uniform token info:id = "ND_power_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/ClampedTint.outputs:out>
            float inputs:in2 = 2.2
            float3 outputs:out
        }

        def Shader "SampleSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorBlend/Sample.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "SampleRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorBlend/SampleSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlend/SampleSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorBlend/SampleSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "Linear"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend/SampleRGB.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend/LinearTint.outputs:out>
            float3 outputs:out
        }

        def Shader "Alpha"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend/SampleSplit.outputs:outw>
            float inputs:in2.connect = </Root/MirrorBlend/TintSplit.outputs:outw>
            float outputs:out
        }

        def Shader "Exposed"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/Linear.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend/Constant0Split.outputs:outx>
            float3 outputs:out
        }

        def Shader "CurveA"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/Exposed.outputs:out>
            float inputs:in2 = 2.51
            float3 outputs:out
        }

        def Shader "CurveB"
        {
            uniform token info:id = "ND_add_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/CurveA.outputs:out>
            float inputs:in2 = 0.03
            float3 outputs:out
        }

        def Shader "CurveNumerator"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend/Exposed.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend/CurveB.outputs:out>
            float3 outputs:out
        }

        def Shader "CurveC"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/Exposed.outputs:out>
            float inputs:in2 = 2.43
            float3 outputs:out
        }

        def Shader "CurveD"
        {
            uniform token info:id = "ND_add_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/CurveC.outputs:out>
            float inputs:in2 = 0.59
            float3 outputs:out
        }

        def Shader "CurveE"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend/Exposed.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend/CurveD.outputs:out>
            float3 outputs:out
        }

        def Shader "CurveDenominator"
        {
            uniform token info:id = "ND_add_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/CurveE.outputs:out>
            float inputs:in2 = 0.14
            float3 outputs:out
        }

        def Shader "CurveRatio"
        {
            uniform token info:id = "ND_divide_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend/CurveNumerator.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorBlend/CurveDenominator.outputs:out>
            float3 outputs:out
        }

        def Shader "Mapped"
        {
            uniform token info:id = "ND_clamp_vector3FA"
            float3 inputs:in.connect = </Root/MirrorBlend/CurveRatio.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float3 outputs:out
        }

        def Shader "Curved"
        {
            uniform token info:id = "ND_mix_vector3"
            float3 inputs:fg.connect = </Root/MirrorBlend/Mapped.outputs:out>
            float3 inputs:bg.connect = </Root/MirrorBlend/Exposed.outputs:out>
            float inputs:mix.connect = </Root/MirrorBlend.inputs:Curve>
            float3 outputs:out
        }

        def Shader "Luma"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/MirrorBlend/Linear.outputs:out>
            float3 inputs:in2 = (0.2126, 0.7152, 0.0722)
            float outputs:out
        }

        def Shader "ColourWeightAlpha"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend/Alpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend.inputs:ColourAlpha>
            float outputs:out
        }

        def Shader "ColourWeight"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend/ColourWeightAlpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend.inputs:ColourBase>
            float outputs:out
        }

        def Shader "Weighted"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorBlend/Curved.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend/ColourWeight.outputs:out>
            float3 outputs:out
        }

        def Shader "RGB"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Root/MirrorBlend/Weighted.outputs:out>
            color3f outputs:out
        }

        def Shader "OpacityFromAlpha"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend/Alpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend.inputs:OpacityAlpha>
            float outputs:out
        }

        def Shader "OpacityFromLuma"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorBlend/Luma.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend.inputs:OpacityLuma>
            float outputs:out
        }

        def Shader "OpacitySum"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend/OpacityFromAlpha.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend/OpacityFromLuma.outputs:out>
            float outputs:out
        }

        def Shader "Opacity"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Root/MirrorBlend/OpacitySum.outputs:out>
            float inputs:in2.connect = </Root/MirrorBlend.inputs:OpacityBase>
            float outputs:out
        }
    }

    def Material "MirrorBlendLit"
    {
        asset inputs:Frame
        asset inputs:Constants
        float4 inputs:Colour = (1, 1, 1, 1)
        float3 inputs:Ambient = (0.2, 0.2, 0.2)
        float inputs:ColourBase = 0
        float inputs:ColourAlpha = 1
        float inputs:OpacityBase = 0
        float inputs:OpacityAlpha = 1
        float inputs:OpacityLuma = 0
        float inputs:Curve = 1
        token outputs:mtlx:surface.connect = </Root/MirrorBlendLit/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            bool inputs:hasPremultipliedAlpha = 1
            color3f inputs:color.connect = </Root/MirrorBlendLit/RGB.outputs:out>
            float inputs:opacity.connect = </Root/MirrorBlendLit/Opacity.outputs:out>
            token outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorBlendLit.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/MirrorBlendLit/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            string inputs:u_wrap_mode = "repeat"
