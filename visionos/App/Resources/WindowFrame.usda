            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "VertexColour"
        {
            uniform token info:id = "ND_geomcolor_color4"
            color4f outputs:out
        }

        def Shader "VertexVector"
        {
            uniform token info:id = "ND_convert_color4_vector4"
            color4f inputs:in.connect = </Root/MirrorBlendLit/VertexColour.outputs:out>
            float4 outputs:out
        }

        def Shader "Tint"
        {
            uniform token info:id = "ND_multiply_vector4"
            float4 inputs:in1.connect = </Root/MirrorBlendLit/VertexVector.outputs:out>
            float4 inputs:in2.connect = </Root/MirrorBlendLit.inputs:Colour>
            float4 outputs:out
        }

        def Shader "TintSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorBlendLit/Tint.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "TintRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorBlendLit/TintSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorBlendLit/TintSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorBlendLit/TintSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "Constant0"
        {
