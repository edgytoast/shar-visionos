#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

# The game's window (GameWindowView.swift). Metal textures start at the top row, as the UVs expect,
# hence no_flip_v.
def Xform "Root"
{
    # An eye's relief: its half of the side-by-side scene (the mesh's UVs say which), shown only to
    # that eye. The camera index switch gives 0 for the left eye (and mono rendering, screenshots)
    # and 1 for the right; opacity is 1 where that matches Eye and 0 where not, cut out at 0.5.
    def Material "ReliefFrame"
    {
        asset inputs:Frame
        float inputs:Eye = 0
        token outputs:mtlx:surface.connect = </Root/ReliefFrame/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            color3f inputs:color.connect = </Root/ReliefFrame/Sample.outputs:out>
            float inputs:opacity.connect = </Root/ReliefFrame/Visible.outputs:out>
            float inputs:opacityThreshold = 0.5
            token outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_color3"
            asset inputs:file.connect = </Root/ReliefFrame.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/ReliefFrame/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            color3f outputs:out
        }

        def Shader "UV"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "CameraEye"
        {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_float"
            float inputs:mono = 0
            float inputs:left = 0
            float inputs:right = 1
            float outputs:out
        }

        def Shader "EyeDifference"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Root/ReliefFrame/CameraEye.outputs:out>
            float inputs:in2.connect = </Root/ReliefFrame.inputs:Eye>
            float outputs:out
        }

        def Shader "EyeDistance"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Root/ReliefFrame/EyeDifference.outputs:out>
            float outputs:out
        }

        def Shader "Visible"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 1
            float inputs:in2.connect = </Root/ReliefFrame/EyeDistance.outputs:out>
            float outputs:out
        }
    }

    # The HUD, flat on the window's face, its alpha premultiplied (visionos_window.mm).
    def Material "HudFrame"
    {
        asset inputs:Frame
        token outputs:mtlx:surface.connect = </Root/HudFrame/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            bool inputs:hasPremultipliedAlpha = 1
            color3f inputs:color.connect = </Root/HudFrame/Colour.outputs:out>
            float inputs:opacity.connect = </Root/HudFrame/Alpha.outputs:outw>
            token outputs:out
        }

        def Shader "Colour"
        {
            uniform token info:id = "ND_RealityKitTexture2D_color3"
            asset inputs:file.connect = </Root/HudFrame.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/HudFrame/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            color3f outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/HudFrame.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/HudFrame/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            float4 outputs:out
        }

        def Shader "Alpha"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/HudFrame/Sample.outputs:out>
            float outputs:outw
        }

        def Shader "UV"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
    }

    # The window's scene mirror (MirrorScene.swift), generated by scripts/gen-mirror-materials.py:
    # a game mesh's texture times its vertex colour
    # and material colour, unlit, as the engine's own unlit path does it (compact.frag), then
    # exposed and tone-mapped as its HDR resolve does (hdr_resolve.frag: ACES, fitted). The engine
    # multiplies in gamma space and linearises the product; the tint's colour is raised to 2.2 to
    # do the same to the linear texture. The Lit variants, for lit draws (characters, cars, props),
    # light the vertex colour as lit.vert does: the draw's Ambient plus the material colour times
    # each light's colour times N.L (the material colour, a car's paint, tints only the lights). The
    # level's own geometry is prelit, and its materials skip the lights' cost.
    # Constants is an 8x1 texture every material shares, so a frame's changes touch none of them:
    # texel 0 is (exposure, ambient), texels 1-6 each light's direction (towards it, world space)
    # and colour. Opaque, cut out below Cutoff (alpha test), and blended.
    def Material "MirrorOpaque"
    {
        asset inputs:Frame
        asset inputs:Constants
        float4 inputs:Colour = (1, 1, 1, 1)
        token outputs:mtlx:surface.connect = </Root/MirrorOpaque/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            color3f inputs:color.connect = </Root/MirrorOpaque/RGB.outputs:out>
            token outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaque.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/MirrorOpaque/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            string inputs:u_wrap_mode = "repeat"
            string inputs:v_wrap_mode = "repeat"
            float4 outputs:out
        }

        def Shader "UV"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "VertexColour"
        {
            uniform token info:id = "ND_geomcolor_color4"
            color4f outputs:out
        }

        def Shader "VertexVector"
        {
            uniform token info:id = "ND_convert_color4_vector4"
            color4f inputs:in.connect = </Root/MirrorOpaque/VertexColour.outputs:out>
            float4 outputs:out
        }

        def Shader "Tint"
        {
            uniform token info:id = "ND_multiply_vector4"
            float4 inputs:in1.connect = </Root/MirrorOpaque/VertexVector.outputs:out>
            float4 inputs:in2.connect = </Root/MirrorOpaque.inputs:Colour>
            float4 outputs:out
        }

        def Shader "TintSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaque/Tint.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "TintRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaque/TintSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaque/TintSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaque/TintSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "Constant0"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaque.inputs:Constants>
            float2 inputs:texcoord = (0.0625, 0.5)
            float4 outputs:out
        }

        def Shader "Constant0Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaque/Constant0.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "ClampedTint"
        {
            uniform token info:id = "ND_clamp_vector3FA"
            float3 inputs:in.connect = </Root/MirrorOpaque/TintRGB.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float3 outputs:out
        }

        def Shader "LinearTint"
        {
            uniform token info:id = "ND_power_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/ClampedTint.outputs:out>
            float inputs:in2 = 2.2
            float3 outputs:out
        }

        def Shader "SampleSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaque/Sample.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "SampleRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaque/SampleSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaque/SampleSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaque/SampleSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "Linear"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaque/SampleRGB.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaque/LinearTint.outputs:out>
            float3 outputs:out
        }

        def Shader "Alpha"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Root/MirrorOpaque/SampleSplit.outputs:outw>
            float inputs:in2.connect = </Root/MirrorOpaque/TintSplit.outputs:outw>
            float outputs:out
        }

        def Shader "Exposed"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/Linear.outputs:out>
            float inputs:in2.connect = </Root/MirrorOpaque/Constant0Split.outputs:outx>
            float3 outputs:out
        }

        def Shader "CurveA"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/Exposed.outputs:out>
            float inputs:in2 = 2.51
            float3 outputs:out
        }

        def Shader "CurveB"
        {
            uniform token info:id = "ND_add_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/CurveA.outputs:out>
            float inputs:in2 = 0.03
            float3 outputs:out
        }

        def Shader "CurveNumerator"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaque/Exposed.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaque/CurveB.outputs:out>
            float3 outputs:out
        }

        def Shader "CurveC"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/Exposed.outputs:out>
            float inputs:in2 = 2.43
            float3 outputs:out
        }

        def Shader "CurveD"
        {
            uniform token info:id = "ND_add_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/CurveC.outputs:out>
            float inputs:in2 = 0.59
            float3 outputs:out
        }

        def Shader "CurveE"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaque/Exposed.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaque/CurveD.outputs:out>
            float3 outputs:out
        }

        def Shader "CurveDenominator"
        {
            uniform token info:id = "ND_add_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaque/CurveE.outputs:out>
            float inputs:in2 = 0.14
            float3 outputs:out
        }

        def Shader "CurveRatio"
        {
            uniform token info:id = "ND_divide_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaque/CurveNumerator.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaque/CurveDenominator.outputs:out>
            float3 outputs:out
        }

        def Shader "Mapped"
        {
            uniform token info:id = "ND_clamp_vector3FA"
            float3 inputs:in.connect = </Root/MirrorOpaque/CurveRatio.outputs:out>
            float inputs:low = 0
            float inputs:high = 1
            float3 outputs:out
        }

        def Shader "RGB"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Root/MirrorOpaque/Mapped.outputs:out>
            color3f outputs:out
        }
    }

    def Material "MirrorOpaqueLit"
    {
        asset inputs:Frame
        asset inputs:Constants
        float4 inputs:Colour = (1, 1, 1, 1)
        float3 inputs:Ambient = (0.2, 0.2, 0.2)
        token outputs:mtlx:surface.connect = </Root/MirrorOpaqueLit/Surface.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Surface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap = 0
            color3f inputs:color.connect = </Root/MirrorOpaqueLit/RGB.outputs:out>
            token outputs:out
        }

        def Shader "Sample"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Frame>
            float2 inputs:texcoord.connect = </Root/MirrorOpaqueLit/UV.outputs:out>
            uniform bool inputs:no_flip_v = 1
            string inputs:u_wrap_mode = "repeat"
            string inputs:v_wrap_mode = "repeat"
            float4 outputs:out
        }

        def Shader "UV"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "VertexColour"
        {
            uniform token info:id = "ND_geomcolor_color4"
            color4f outputs:out
        }

        def Shader "VertexVector"
        {
            uniform token info:id = "ND_convert_color4_vector4"
            color4f inputs:in.connect = </Root/MirrorOpaqueLit/VertexColour.outputs:out>
            float4 outputs:out
        }

        def Shader "Tint"
        {
            uniform token info:id = "ND_multiply_vector4"
            float4 inputs:in1.connect = </Root/MirrorOpaqueLit/VertexVector.outputs:out>
            float4 inputs:in2.connect = </Root/MirrorOpaqueLit.inputs:Colour>
            float4 outputs:out
        }

        def Shader "TintSplit"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Tint.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "TintRGB"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/TintSplit.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/TintSplit.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/TintSplit.outputs:outz>
            float3 outputs:out
        }

        def Shader "Constant0"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.0625, 0.5)
            float4 outputs:out
        }

        def Shader "Constant0Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant0.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "Constant1"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.1875, 0.5)
            float4 outputs:out
        }

        def Shader "Constant1Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant1.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "Constant2"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.3125, 0.5)
            float4 outputs:out
        }

        def Shader "Constant2Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant2.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "Constant3"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.4375, 0.5)
            float4 outputs:out
        }

        def Shader "Constant3Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant3.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "Constant4"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.5625, 0.5)
            float4 outputs:out
        }

        def Shader "Constant4Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant4.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "Constant5"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.6875, 0.5)
            float4 outputs:out
        }

        def Shader "Constant5Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant5.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "Constant6"
        {
            uniform token info:id = "ND_RealityKitTexture2D_vector4"
            asset inputs:file.connect = </Root/MirrorOpaqueLit.inputs:Constants>
            float2 inputs:texcoord = (0.8125, 0.5)
            float4 outputs:out
        }

        def Shader "Constant6Split"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Root/MirrorOpaqueLit/Constant6.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }

        def Shader "WorldNormal"
        {
            uniform token info:id = "ND_normal_vector3"
            uniform string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "Normal"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in.connect = </Root/MirrorOpaqueLit/WorldNormal.outputs:out>
            float3 outputs:out
        }

        def Shader "Light0Direction"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Constant1Split.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Constant1Split.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/Constant1Split.outputs:outz>
            float3 outputs:out
        }

        def Shader "Light0Colour"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Constant2Split.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Constant2Split.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/Constant2Split.outputs:outz>
            float3 outputs:out
        }

        def Shader "Light0Cosine"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaqueLit/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaqueLit/Light0Direction.outputs:out>
            float outputs:out
        }

        def Shader "Light0Facing"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Light0Cosine.outputs:out>
            float inputs:in2 = 0
            float outputs:out
        }

        def Shader "Light0"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaqueLit/Light0Colour.outputs:out>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Light0Facing.outputs:out>
            float3 outputs:out
        }

        def Shader "Light1Direction"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Constant3Split.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Constant3Split.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/Constant3Split.outputs:outz>
            float3 outputs:out
        }

        def Shader "Light1Colour"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Constant4Split.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Constant4Split.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/Constant4Split.outputs:outz>
            float3 outputs:out
        }

        def Shader "Light1Cosine"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaqueLit/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaqueLit/Light1Direction.outputs:out>
            float outputs:out
        }

        def Shader "Light1Facing"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Light1Cosine.outputs:out>
            float inputs:in2 = 0
            float outputs:out
        }

        def Shader "Light1"
        {
            uniform token info:id = "ND_multiply_vector3FA"
            float3 inputs:in1.connect = </Root/MirrorOpaqueLit/Light1Colour.outputs:out>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Light1Facing.outputs:out>
            float3 outputs:out
        }

        def Shader "Lighting1"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaqueLit/Light0.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaqueLit/Light1.outputs:out>
            float3 outputs:out
        }

        def Shader "Light2Direction"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Constant5Split.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Constant5Split.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/Constant5Split.outputs:outz>
            float3 outputs:out
        }

        def Shader "Light2Colour"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Constant6Split.outputs:outx>
            float inputs:in2.connect = </Root/MirrorOpaqueLit/Constant6Split.outputs:outy>
            float inputs:in3.connect = </Root/MirrorOpaqueLit/Constant6Split.outputs:outz>
            float3 outputs:out
        }

        def Shader "Light2Cosine"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1.connect = </Root/MirrorOpaqueLit/Normal.outputs:out>
            float3 inputs:in2.connect = </Root/MirrorOpaqueLit/Light2Direction.outputs:out>
            float outputs:out
        }

        def Shader "Light2Facing"
        {
            uniform token info:id = "ND_max_float"
            float inputs:in1.connect = </Root/MirrorOpaqueLit/Light2Cosine.outputs:out>
            float inputs:in2 = 0
